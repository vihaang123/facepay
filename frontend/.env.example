# Copy to frontend/.env.local for local development. Only VITE_-prefixed variables reach the browser; never put secrets here.
# Production (Vercel): set VITE_API_BASE_URL in Project Settings > Environment Variables to the public HTTPS URL of the
# Render backend, no trailing slash. It is compiled in at build time, so redeploy after changing it.
VITE_API_BASE_URL=http://localhost:8000
