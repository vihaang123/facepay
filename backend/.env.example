# Copy to .env and fill in. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Per-IP limit on login/registration attempts (in-memory, single instance)
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
# AES-256 key for stored face data: 32 random bytes, base64. Generate with:
#   python -c "from app.core.crypto import generate_key; print(generate_key())"
# Never commit it. Changing it makes existing face data unreadable (users must re-enroll).
BIOMETRIC_KEY=
FACE_RATE_LIMIT_PER_MINUTE=60
TRAIN_RATE_LIMIT_PER_MINUTE=5

# Used only by pytest. The database name MUST end in _test (tests reset the schema).
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME_test
