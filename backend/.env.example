# Copy to backend/.env for local development. Never commit .env.
# In production (Render) set these in the service's Environment tab instead; there is no .env file on the host.
# "Prod" column below: REQUIRED = the app will not start (or cannot work) without it; optional = has a safe default.

# --- Core ----------------------------------------------------------------------------------------
# Prod: REQUIRED, set to "production". Turns on the startup secret checks and disables /docs, /redoc, /openapi.json.
APP_ENV=development

# Prod: REQUIRED. PostgreSQL connection string. Hosted providers' postgres:// and postgresql:// URLs are accepted
# and rewritten to the psycopg 3 driver. On Render use the database's Internal Database URL.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Prod: REQUIRED. Signs login tokens. At least 16 characters; use 48+ random ones. The example value is refused in production.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Prod: REQUIRED. AES-256 key for stored face samples, models and profiles: 32 random bytes, base64.
# The app refuses to start in production if it is missing or malformed. Generate it once, keep it only in the host's
# secret store plus a private backup, and never commit it. Changing or losing it makes existing face data unreadable
# (users must re-enrol). Run inside backend/:
#   python -c "from app.core.crypto import generate_key; print(generate_key())"
BIOMETRIC_KEY=

# Prod: REQUIRED. Exact frontend origin(s), comma separated, scheme + host, no path, no trailing slash, never "*"
# (refused in production). Example: https://your-app.vercel.app. Update it once the Vercel URL is known.
CORS_ORIGINS=http://localhost:5173

# --- Optional (defaults shown) -------------------------------------------------------------------
# Prod: optional. Token lifetime.
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Prod: optional, keep rate limiting on. Counters live in process memory, so run one instance and one worker.
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
FACE_RATE_LIMIT_PER_MINUTE=60
FACE_AUTH_RATE_LIMIT_PER_MINUTE=10
PAYMENT_RATE_LIMIT_PER_MINUTE=30
TRAIN_RATE_LIMIT_PER_MINUTE=5

# --- Host-provided / tests -----------------------------------------------------------------------
# PORT is injected by Render and read by the Docker start command (default 8000). Do not set it yourself.
# FORWARDED_ALLOW_IPS is read by uvicorn, not by the app. Behind Render's proxy set it to * so the per-IP rate limits
# see the real client address (render.yaml does this). Do not set it when the app is directly exposed.

# Tests only (pytest). Never set on a host. The database name MUST end in _test (tests reset the schema).
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME_test
